{
  "name": "intruder-yankee-station",
  "version": "1.0.0",
  "private": true,
  "description": "Development and actual-browser regression tooling for the existing custom WebGL game",
  "scripts": {
    "dev": "node tools/dev-server.cjs",
    "test": "node tests/run-browser.cjs",
    "test:missions": "node tests/run-browser.cjs --suite=missions",
    "test:progression": "node tests/run-browser.cjs --suite=progression",
    "test:regressions": "node tests/run-browser.cjs --suite=regressions",
    "test:assets": "node tests/check-preservation.cjs && python3 tests/check-atlases.py",
    "browsers:install": "playwright install chromium webkit",
    "build": "node tools/package-build.cjs",
    "test:ground": "node tests/run-browser.cjs --suite=ground",
    "test:renderer": "node tests/run-browser.cjs --suite=renderer",
    "test:build": "node tests/build-browser.cjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=20"
  }
}
